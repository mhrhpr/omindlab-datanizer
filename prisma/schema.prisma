generator client { provider = "prisma-client-js" }

datasource db { provider = "postgresql" }

model User { id String @id @default(cuid()) email String @unique passwordHash String role String @default("admin") createdAt DateTime @default(now()) leads Lead[] notes LeadNote[] }
model Lead { id String @id @default(cuid()) referenceCode String @unique name String email String phone String companyName String companySize String? industry String? problemDescription String currentWorkflow String? desiredOutcome String? painLevel String? frequency String? budgetRange String? contactMethod String? status String @default("New") leadQuality String? source String? utmSource String? utmMedium String? utmCampaign String? utmContent String? utmTerm String? referrer String? landingPage String? createdAt DateTime @default(now()) updatedAt DateTime @updatedAt diagnosis LeadDiagnosis? events LeadEvent[] notes LeadNote[] matches Match[] deals Deal[] }
model LeadDiagnosis { id String @id @default(cuid()) leadId String @unique lead Lead @relation(fields:[leadId],references:[id],onDelete:Cascade) problemCategory String problemSummary String solutionTypes Json estimatedComplexity String urgency String likelyServices Json missingInformation Json suggestedQuestions Json leadQuality String recommendedNextAction String rawAiOutput Json createdAt DateTime @default(now()) updatedAt DateTime @updatedAt }
model Expert { id String @id @default(cuid()) name String email String phone String? linkedin String? primaryExpertise String secondaryExpertise String? yearsExperience Int industries Json skills Json availability String? engagementTypes Json expectedRate String? portfolioUrl String? cvUrl String? description String? location String? remote Boolean @default(true) status String @default("Pending") createdAt DateTime @default(now()) updatedAt DateTime @updatedAt matches Match[] }
model Match { id String @id @default(cuid()) leadId String expertId String lead Lead @relation(fields:[leadId],references:[id],onDelete:Cascade) expert Expert @relation(fields:[expertId],references:[id],onDelete:Cascade) proposedService String proposedScope String? estimatedValue Float? status String @default("Proposed") notes String? createdAt DateTime @default(now()) }
model LeadNote { id String @id @default(cuid()) leadId String authorId String lead Lead @relation(fields:[leadId],references:[id],onDelete:Cascade) author User @relation(fields:[authorId],references:[id],onDelete:Cascade) content String createdAt DateTime @default(now()) }
model LeadEvent { id String @id @default(cuid()) leadId String lead Lead @relation(fields:[leadId],references:[id],onDelete:Cascade) eventType String metadata Json createdAt DateTime @default(now()) }
model Deal { id String @id @default(cuid()) leadId String lead Lead @relation(fields:[leadId],references:[id],onDelete:Cascade) value Float recurringValue Float? status String @default("Open") notes String? createdAt DateTime @default(now()) updatedAt DateTime @updatedAt }
model SeoPage { id String @id @default(cuid()) key String @unique title String description String keywords Json canonical String robots String @default("index,follow") ogImage String? updatedAt DateTime @updatedAt }
model SeoRun { id String @id @default(cuid()) status String startedAt DateTime @default(now()) completedAt DateTime? summary String? metrics Json? }
model SeoRecommendation { id String @id @default(cuid()) runId String run SeoRun @relation(fields:[runId],references:[id],onDelete:Cascade) pageKey String action String reason String priority String status String @default("pending") payload Json createdAt DateTime @default(now()) }
